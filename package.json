{
  "name": "retrotunes",
  "productName": "RetroTunes (rTunes)",
  "version": "1.0.0",
  "description": "Late-2000s Brushed-Metal Desktop Media Player, Homelab Media Gateway, & Universal ePod Sync Engine",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite --port 5173",
    "build:mtp": "node scripts/electron-tasks.mjs build-mtp",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && node scripts/electron-tasks.mjs launch dev",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "npm run build:mtp && npm run build:electron && vite build",
    "start": "npm run build && node scripts/electron-tasks.mjs launch prod",
    "postinstall": "node scripts/electron-tasks.mjs rebuild-native",
    "cli": "cross-env ELECTRON_RUN_AS_NODE=1 electron dist-electron/cli.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.16.0",
    "music-metadata": "^11.12.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4"
  }
}
